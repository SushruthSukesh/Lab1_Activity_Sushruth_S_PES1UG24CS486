<mxfile host="app.diagrams.net">
  <diagram id="bookclub-usecase" name="Book Club Use Case Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- System Boundary -->
        <mxCell id="boundary" value="Book Club Portal System Boundary" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#1E293B;align=left;spacingLeft=20;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="620" height="720" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="actor_member" value="Club Member" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#1E293B;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="50" height="90" as="geometry" />
        </mxCell>

        <mxCell id="actor_lead" value="Discussion Lead" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#1E293B;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="50" height="90" as="geometry" />
        </mxCell>

        <mxCell id="actor_system" value="Authentication &amp;&#xa;Backend System" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#F1F5F9;strokeColor=#475569;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="960" y="380" width="50" height="90" as="geometry" />
        </mxCell>

        <!-- Generalization Lead -> Member -->
        <mxCell id="gen_lead_member" value="&amp;#171;specializes&amp;#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;strokeColor=#475569;fontSize=10;fontColor=#64748B;" edge="1" parent="1" source="actor_lead" target="actor_member">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Primary Use Cases -->
        <mxCell id="uc1" value="UC-01: Set &amp; Track&#xa;Reading Goals" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="180" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc2" value="UC-02: Participate in Chapter&#xa;Discussion Thread" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="180" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc3" value="UC-03: Create &amp; Moderate&#xa;Discussion Thread" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="180" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc4" value="UC-04: Vote in Monthly&#xa;Book Selection Poll" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="300" y="550" width="180" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc5" value="UC-05: Create &amp; Manage&#xa;Monthly Poll" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="300" y="680" width="180" height="65" as="geometry" />
        </mxCell>

        <!-- Stereotyped Use Cases -->
        <mxCell id="uc6" value="UC-06: Award Milestone&#xa;Badge" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc7" value="UC-07: Reveal Spoiler&#xa;Content" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc8" value="UC-08: Verify User Session&#xa;&amp; Authenticate" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="640" y="430" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc9" value="UC-09: Tally &amp; Publish&#xa;Real-Time Results" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- Associations -->
        <mxCell id="edge_m_uc1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="actor_member" target="uc1" />
        <mxCell id="edge_m_uc2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="actor_member" target="uc2" />
        <mxCell id="edge_m_uc4" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="actor_member" target="uc4" />

        <mxCell id="edge_l_uc3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="actor_lead" target="uc3" />
        <mxCell id="edge_l_uc5" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="actor_lead" target="uc5" />

        <mxCell id="edge_sys_uc8" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="actor_system" target="uc8" />
        <mxCell id="edge_sys_uc9" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="actor_system" target="uc9" />

        <!-- Stereotype Relations -->
        <mxCell id="rel_extend_badge" value="&amp;#171;extend&amp;#187;" style="edgeStyle=none;dashed=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;strokeColor=#D97706;strokeWidth=1.5;fontSize=10;fontColor=#D97706;" edge="1" parent="1" source="uc6" target="uc1" />
        <mxCell id="rel_extend_spoiler" value="&amp;#171;extend&amp;#187;" style="edgeStyle=none;dashed=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;strokeColor=#D97706;strokeWidth=1.5;fontSize=10;fontColor=#D97706;" edge="1" parent="1" source="uc7" target="uc2" />

        <mxCell id="rel_inc_poll_auth" value="&amp;#171;include&amp;#187;" style="edgeStyle=none;dashed=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#2563EB;" edge="1" parent="1" source="uc4" target="uc8" />
        <mxCell id="rel_inc_poll_tally" value="&amp;#171;include&amp;#187;" style="edgeStyle=none;dashed=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#2563EB;" edge="1" parent="1" source="uc4" target="uc9" />
        <mxCell id="rel_inc_disc_auth" value="&amp;#171;include&amp;#187;" style="edgeStyle=none;dashed=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#2563EB;" edge="1" parent="1" source="uc2" target="uc8" />
        <mxCell id="rel_inc_mod_auth" value="&amp;#171;include&amp;#187;" style="edgeStyle=none;dashed=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#2563EB;" edge="1" parent="1" source="uc3" target="uc8" />

      </root>
    </mxGraphModel>
